---
// One stake (Planting Plan direction): a solid bed-colour band across the
// top naming its bed in words (only when the checker has placed it in a
// group — catch-up's un-evaluated cards and non-counting courses get no
// band), then code, title, units, the status mark (or nothing, on
// catch-up), the reasons behind it, and a remove form (plain POST/redirect).
import StatusBadge from "./StatusBadge.astro";
import type { CourseResult } from "../lib/checker-types";

interface Props {
  code: string;
  title: string | null;
  units: number;
  unverified: boolean;
  removeAction: string;
  planId: string;
  planCourseId: number;
  from: "plan" | "catchup";
  result?: CourseResult;
  /** D15 (epic.md 16): current waiver state, straight from plan_courses —
   * needed even when `result`'s messages no longer show a prereq note
   * (waiving replaces it), so "Undo permission" still has something to
   * show. */
  prereqWaived?: boolean;
  /** This stake's bed colour (and the text colour that reads on it), looked
   * up by the page from the group this course fills (`result.groupName`)
   * via src/components/beds.ts. Absent when the course fills no group. */
  bedColor?: string;
  bedTextColor?: string;
}

const {
  code,
  title,
  units,
  unverified,
  removeAction,
  planId,
  planCourseId,
  from,
  result,
  prereqWaived = false,
  bedColor,
  bedTextColor,
} = Astro.props;

// D15: the button shows whenever there's a live prerequisite message to
// waive (amber "Needs ... first" or grey "Check P&C: ...") — or, once
// waived, so "Undo permission" stays available even though the waiver
// replaced that message with its own note.
const hasPrereqMessage =
  result?.messages.some((m) => m.startsWith("Needs ") || m.startsWith("Check P&C:")) ?? false;
const showWaiverButton = hasPrereqMessage || prereqWaived;
---

<li class="course-card">
  {
    result?.groupName && bedColor && (
      <div class="course-card__band" style={`--band-color:${bedColor};--band-text:${bedTextColor ?? "#ffffff"}`}>
        {result.groupName}
      </div>
    )
  }
  <div class="course-card__body">
    <div class="course-card__head">
      <span class="course-code">{code}</span>
      {unverified && <span class="tag-unverified">unverified</span>}
      <span class="course-units">{units} units</span>
    </div>
    <p class="course-title">{title ?? "No title on record for this code."}</p>
    {result && <StatusBadge status={result.status} groupName={result.groupName} />}
    {
      result && result.messages.length > 0 && (
        <ul class="course-messages">
          {result.messages.map((message) => (
            <li>{message}</li>
          ))}
        </ul>
      )
    }
    {
      showWaiverButton && (
        <form method="post" action="/api/plan-courses" class="course-waiver-form">
          <input type="hidden" name="intent" value={prereqWaived ? "unwaive-prereq" : "waive-prereq"} />
          <input type="hidden" name="planId" value={planId} />
          <input type="hidden" name="planCourseId" value={planCourseId} />
          <input type="hidden" name="from" value={from} />
          {
            prereqWaived && (
              <svg class="pin-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 3.5c-3 0-5.4 2.3-5.4 5.3 0 3.7 4 8.6 5 9.6.2.2.6.2.8 0 1-1 5-5.9 5-9.6 0-3-2.4-5.3-5.4-5.3Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                ></path>
                <circle cx="12" cy="8.8" r="1.8" fill="currentColor"></circle>
              </svg>
            )
          }
          <button type="submit" class="btn btn-ghost">
            {prereqWaived ? "Undo permission" : "I have permission to enrol"}
          </button>
        </form>
      )
    }
    <form method="post" action={removeAction} class="course-remove-form">
      <input type="hidden" name="intent" value="remove" />
      <input type="hidden" name="planId" value={planId} />
      <input type="hidden" name="planCourseId" value={planCourseId} />
      <input type="hidden" name="from" value={from} />
      <button type="submit" class="btn btn-ghost">Remove {code}</button>
    </form>
  </div>
</li>
