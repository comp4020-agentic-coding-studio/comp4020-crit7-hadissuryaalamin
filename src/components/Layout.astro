---
// Shared page shell: nav, main, footer disclaimer (epic.md section 10).
// No ANU logo or branding imitation — text only.
import "../styles.css";

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Degree Plan Checker</a>
      <a href="/readme/">About</a>
    </nav>
    <main class={wide ? "wide" : undefined}>
      <slot />
    </main>
    <footer>
      <p>
        Not affiliated with ANU. Course and program data is from ANU Programs
        &amp; Courses, snapshotted 24 September 2026 — always confirm against
        the <a href="https://programsandcourses.anu.edu.au/">official Programs &amp; Courses site</a>{" "}
        before enrolling.
      </p>
    </footer>
    <script is:inline>
      // 2026-09-25 (epic.md 18.1): scroll stays put after add/remove/waive/
      // unwaive. Mutations are plain-form POST/redirect (rule 5) so this
      // can't carry state through the request itself — it saves scrollY to
      // sessionStorage right before a plan-mutation form submits, and
      // restores it once the redirected page loads. Progressive enhancement
      // only: with JS off the browser just lands at the top, same as today.
      (function () {
        try {
          var key = "scrollY:" + location.pathname;
          document.addEventListener("submit", function (event) {
            var form = event.target;
            if (form instanceof HTMLFormElement && form.method === "post") {
              try {
                sessionStorage.setItem(key, String(window.scrollY));
              } catch {}
            }
          });
          var saved = sessionStorage.getItem(key);
          if (saved !== null) {
            sessionStorage.removeItem(key);
            var y = Number(saved);
            if (Number.isFinite(y)) {
              window.scrollTo(0, y);
            }
          }
        } catch {}
      })();
    </script>
  </body>
</html>
